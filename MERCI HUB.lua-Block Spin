    end,
})

task.spawn(function()
    while task.wait(0.1) do
        if Config.Magnet then
            -- ยิง Event ตามที่ระบุ
            pcall(function()
                LocalEvent:FireServer()
            end)

            -- ดึง Drop Items ใน Workspace เข้าตัว
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj:IsA("Tool") or obj:IsA("Model") and obj:FindFirstChild("Handle") then
                        local part = obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
                        if part then
                            part.CFrame = hrp.CFrame
                        end
                    end
                end
            end
        end
    end
end)

