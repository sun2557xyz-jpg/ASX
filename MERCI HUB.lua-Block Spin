-- 8. ดูดของ + ยิง Event (Event:FireServer Auto Run)
------------------------------------------------------------------
MainTab:CreateToggle({
    Name = "8. Item Magnet + Spawn Galaxy Block",
    CurrentValue = false,
    Callback = function(Value)
