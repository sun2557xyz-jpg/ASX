-- 6. หลบกระสุน (Dodge/Desync Base)
------------------------------------------------------------------
CombatTab:CreateToggle({
    Name = "6. Dodge Bullets (หลบกระสุน)",
    CurrentValue = false,
    Callback = function(Value)
        Config.AntiBullet = Value
    end,
})

RunService.Heartbeat:Connect(function()
    if Config.AntiBullet and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local oldVelocity = hrp.Velocity
        -- สลับ CFrame หลอกตำแหน่งฝั่ง Client
        hrp.Velocity = Vector3.new(math.random(-50, 50), 0, math.random(-50, 50))
        RunService.RenderStepped:Wait()
        hrp.Velocity = oldVelocity
    end
end)

------------------------------------------------------------------
-- 7. กันแบน กันดำ (Basic Client Anti-Ban/Spoof)
------------------------------------------------------------------
MainTab:CreateToggle({
    Name = "7. Anti-Ban / Anti-Blacklist (กันแบน)",
    CurrentValue = false,
    Callback = function(Value)
        Config.AntiBan = Value
        if Value then
            -- ป้องกันการดักจับของ Namecall บน Client
            local gmt = getrawmetatable(game)
            setreadonly(gmt, false)
            local oldNamecall = gmt.__namecall

            gmt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if Config.AntiBan and (method == "Kick" or method == "Ban") then
                    return nil -- ระงับคำสั่ง Kick/Ban
                end
                return oldNamecall(self, ...)
            end)
        end
    end,
})

